{
  "manifest_version": 3,
  "name": "Claude Counter",
  "version": "1.0.343",
  "description": "Monitor Claude AI token usage, session limits, weekly limits, and cache timer in real-time.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/content/constants.js",
        "src/content/tokens.js",
        "src/content/ui.js",
        "src/content/bridge-client.js",
        "src/content/main.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected/bridge.js",
        "src/vendor/o200k_base.js"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-counter@extension",
      "strict_min_version": "109.0"
    }
  }
}
